  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Variables in h5: \>\"", ",", 
   RowBox[{"Variables", "[", "h5", "]"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"t1Roots", "=", 
   RowBox[{"t1", "/.", " ", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{"h5", "==", "0"}], ",", "t1", ",", "Reals"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<t1 roots: \>\"", ",", "t1Roots"}], "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sols", "=", 
