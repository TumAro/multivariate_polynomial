                  RowBox[{"NSolve", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"f2", "/.", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"t1", "->", "tv"}], ",", 
                    RowBox[{"t2", "->", "t2v"}]}], "}"}]}], ")"}], "==", 
                    "0"}], ",", "t3", ",", "Reals"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"tv", ",", "t2v", ",", "#"}], "}"}], "&"}], "/@", 
                 "t3Roots"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t2v", ",", "t2Roots"}], "}"}]}], "]"}], ",", "1"}], 
            "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"tv", ",", "t1Roots"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Print", "[", "sols", "]"}]}], "Input",
