Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"h4", ",", "h5", ",", "t1Roots", ",", "sols"}], "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"h4", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"Resultant", "[", 
     RowBox[{"f2", ",", "f3", ",", "t3"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h5", "=", 
